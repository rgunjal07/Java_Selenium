<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Order Validation Suite" parallel="tests" thread-count="1">
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>
    <test name="SauceDemo order validation">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.automation.tests.ECommerceOrderValidationTest"/>
        </classes>
    </test>
</suite>
